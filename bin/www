#!/usr/bin/env node

/**
 * Start all 4 microservices
 */

require('dotenv').config();
const http = require('http');

const usersApp = require('../services/users-service');
const costsApp = require('../services/costs-service');
const logsApp = require('../services/logs-service');
const adminApp = require('../services/admin-service');

// Service configuration
const services = {
  users: { app: usersApp, port: process.env.USERS_PORT},
  costs: { app: costsApp, port: process.env.COSTS_PORT },
  logs: { app: logsApp, port: process.env.LOGS_PORT },
  admin: { app: adminApp, port: process.env.ABOUT_PORT },
};

let servicesRunning = 0;

// Start all services
const serviceEntries = Object.entries(services);
let delayMs = 0;

serviceEntries.forEach(([name, config], index) => {
  setTimeout(() => {
    const server = http.createServer(config.app);
    
    // Enable SO_REUSEADDR to allow reuse of port in TIME_WAIT state
    server.on('error', (error) => {
      if (error.code === 'EADDRINUSE') {
        console.error(`[ERROR] ${name} service:`, error.message);
        console.error(`  Port ${config.port} is already in use`);
        console.error(`  Try: taskkill /F /IM node.exe`);
        process.exit(1);
      }
    });
    
    server.listen(config.port, 'localhost', () => {
      console.log(`[OK] ${name.toUpperCase()} service on http://localhost:${config.port}`);
      servicesRunning++;
    });
  }, delayMs);
  
  delayMs += 500; // 500ms stagger between service starts
});

// Handle graceful shutdown
process.on('SIGINT', () => {
  console.log('\n\nShutting down all services...');
  process.exit(0);
});

process.on('SIGTERM', () => {
  console.log('\n\nTerminating all services...');
  process.exit(0);
});

