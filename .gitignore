# Node.js dependencies
node_modules/

# dotenv environment files (do not commit secrets)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data / process ids
pids/
*.pid
*.seed
*.pid.lock

# Test coverage
coverage/
.nyc_output/

# Build outputs (if any)
dist/
build/

# OS / Editor files
.DS_Store
Thumbs.db
Desktop.ini

# JetBrains IDE (WebStorm/IntelliJ)
.idea/
*.iml

# Optional: local history/plugin files
.idea_modules/

# Optional: cache folders
.cache/
.tmp/

# Optional: TypeScript (project is JS, but ignore if generated)
*.tsbuildinfo

# Optional: eslint cache
.eslintcache

